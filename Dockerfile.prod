# ── Stage 1: Build ────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install deps first (cache layer)
COPY package*.json ./
RUN npm install

# Copy source and build
COPY . .
RUN npm run build
# Vite outputs to /app/dist — this is all we need

# ── Stage 2: Production ───────────────────────────────────────────────────
# nginx is a high-performance web server — perfect for serving static files
# The alpine variant is only ~8 MB
FROM nginx:alpine AS production

# Copy ONLY the built static files from Stage 1
# Everything else from the builder (node_modules, src, etc.) is discarded
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy a custom nginx config (see below)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# nginx starts automatically — no CMD needed
CMD ["nginx", "-g", "daemon off;"]